<%# data-turbo-temporary：Turbo が画面を写して取っておく前（turbo:before-cache）に知らせを消す。ブラウザの「戻る」で、前の知らせがまた出ないようにする %>
<div id="flash" data-turbo-temporary>
  <%# ×のボタン（dismiss）：JavaScript が動かないときは閉じられないので、初めは hidden にし、dismiss の connect で出す。type="button"：フォームの中に置いても送らない %>
  <% flash.each do |type, message| %>
    <% if type == "notice" %>
      <div data-controller="dismiss" class="mx-4 mt-4 flex items-start gap-2 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800" role="status">
        <%= render "shared/check_circle_icon", color: "text-green-700" %>
        <p class="grow"><%= message %></p>
        <button type="button" hidden data-dismiss-target="button" data-action="dismiss#close" aria-label="<%= t(".close") %>" class="-m-1 shrink-0 cursor-pointer rounded-lg p-1 hover:bg-black/5 active:bg-black/10">
          <%= render "shared/x_mark_icon", color: "text-green-700" %>
        </button>
      </div>
    <% elsif type == "alert" %>
      <div data-controller="dismiss" class="mx-4 mt-4 flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        <%= render "shared/exclamation_circle_icon", color: "text-red-700" %>
        <p class="grow"><%= message %></p>
        <button type="button" hidden data-dismiss-target="button" data-action="dismiss#close" aria-label="<%= t(".close") %>" class="-m-1 shrink-0 cursor-pointer rounded-lg p-1 hover:bg-black/5 active:bg-black/10">
          <%= render "shared/x_mark_icon", color: "text-red-700" %>
        </button>
      </div>
    <% end %>
  <% end %>
</div>
