<%# data-turbo-temporary：Turbo が画面を写して取っておく前（turbo:before-cache）に知らせを消す。ブラウザの「戻る」で、前の知らせがまた出ないようにする %>
<div id="flash" data-turbo-temporary>
  <% flash.each do |type, message| %>
    <% if type == "notice" %>
      <div class="mx-4 mt-4 flex items-start gap-2 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800" role="status">
        <%= render "shared/check_circle_icon", color: "text-green-700" %>
        <p><%= message %></p>
      </div>
    <% elsif type == "alert" %>
      <div class="mx-4 mt-4 flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        <%= render "shared/exclamation_circle_icon", color: "text-red-700" %>
        <p><%= message %></p>
      </div>
    <% end %>
  <% end %>
</div>
