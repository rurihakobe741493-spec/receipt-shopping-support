<div id="flash">
  <% flash.each do |type, message| %>
    <% if type == "notice" %>
      <p class="mx-4 mt-4 rounded border border-green-200 bg-green-50 px-4 py-2 text-sm text-green-800" role="status"><%= message %></p>
    <% elsif type == "alert" %>
      <p class="mx-4 mt-4 rounded border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800" role="alert"><%= message %></p>
    <% end %>
  <% end %>
</div>
