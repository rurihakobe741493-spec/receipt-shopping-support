<header class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b bg-white px-4 py-3">
  <%# 狭い画面では、アプリ名を「…」で切り、右のリンクは折り返さない %>
  <%= link_to root_path, class: "flex min-w-0 items-center gap-1.5 text-lg font-bold" do %>
    <%# アイコン：Heroicons（MIT、Tailwind Labs）の shopping-bag。ロゴの印 %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-6 shrink-0 text-teal-600">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
    </svg>
    <span class="truncate"><%= app_name %></span>
  <% end %>
  <nav class="flex shrink-0 items-center gap-4 whitespace-nowrap">
    <%# 今いる画面へのリンクは出さない。current_page? だと失敗して描き直した画面（POST・PUT の応答）で false になるので、コントローラーの名前で見る %>
    <% if user_signed_in? %>
      <% unless controller_name == "registrations" %>
        <%= link_to t(".account"), edit_user_registration_path, class: "text-stone-600 hover:text-stone-800" %>
      <% end %>
      <%= button_to t(".sign_out"), destroy_user_session_path, method: :delete, class: "cursor-pointer text-stone-600 hover:text-stone-800" %>
    <% else %>
      <% unless controller_name == "sessions" %>
        <%= link_to t(".sign_in"), new_user_session_path, class: "text-stone-600 hover:text-stone-800" %>
      <% end %>
      <% unless controller_name == "registrations" %>
        <%= link_to t(".sign_up"), new_user_registration_path, class: "text-stone-600 hover:text-stone-800" %>
      <% end %>
    <% end %>
  </nav>
</header>
