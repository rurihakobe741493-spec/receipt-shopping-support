<div class="px-4 py-10">
  <h1 class="mb-8 text-center text-2xl font-bold"><%= t(".title") %></h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <div>
      <%= f.label :email, class: "mb-2 block text-stone-600" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-xl border border-stone-500 px-4 py-3" %>
    </div>

    <div>
      <%= f.label :password, class: "mb-2 block text-stone-600" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-xl border border-stone-500 px-4 py-3" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "size-4 cursor-pointer" %>
        <%= f.label :remember_me, class: "cursor-pointer text-stone-600" %>
      </div>
    <% end %>

    <%= f.submit t(".submit"), class: "w-full cursor-pointer rounded-xl bg-teal-700 py-3 text-lg text-white hover:bg-teal-800" %>
  <% end %>

  <p class="mt-6 text-center">
    <%= link_to t(".sign_up"), new_user_registration_path, class: "text-teal-700 hover:text-teal-800" %>
  </p>

  <%# 「または」の線の下に、ゲストで試すボタン（トップと同じ部品） %>
  <div class="mt-8 flex items-center gap-3 text-sm text-stone-600">
    <span aria-hidden="true" class="h-px flex-1 bg-stone-300"></span>
    <%= t(".or") %>
    <span aria-hidden="true" class="h-px flex-1 bg-stone-300"></span>
  </div>
  <div class="mt-4">
    <%= render "shared/guest_sign_in_button" %>
  </div>
  <p class="mt-3 text-center text-xs text-stone-600"><%= t("shared.guest_sign_in.note") %></p>
</div>
