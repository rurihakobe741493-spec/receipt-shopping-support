<div class="px-4 py-10">
  <h1 class="mb-8 text-center text-2xl">ログイン</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <div>
      <%= f.label :email, class: "mb-2 block text-neutral-300" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-xl border px-4 py-3" %>
    </div>

    <div>
      <%= f.label :password, class: "mb-2 block text-neutral-300" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-xl border px-4 py-3" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "size-4 cursor-pointer" %>
        <%= f.label :remember_me, class: "cursor-pointer text-neutral-300" %>
      </div>
    <% end %>

    <%= f.submit "ログインする", class: "w-full cursor-pointer rounded-xl bg-neutral-100 py-3 text-lg text-neutral-900 hover:bg-neutral-300" %>
  <% end %>

  <p class="mt-6 text-center">
    <%= link_to "新規登録はこちら", new_user_registration_path, class: "text-blue-400 hover:text-blue-300" %>
  </p>
</div>
