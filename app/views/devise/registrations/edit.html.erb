<div class="px-4 py-10">
  <h1 class="mb-8 text-center text-2xl"><%= t(".title") %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "mb-2 block text-stone-600" %>
      <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-xl border border-stone-500 px-4 py-3" %>
    </div>

    <div>
      <div class="mb-2 flex items-baseline">
        <%= f.label :password, t(".password_label"), class: "text-stone-600" %>
        <% if @minimum_password_length %>
          <span class="text-sm text-stone-600"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></span>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-xl border border-stone-500 px-4 py-3",
            aria: { describedby: f.field_id(:password, :note) } %>
      <p id="<%= f.field_id(:password, :note) %>" class="mt-2 text-sm text-stone-600"><%= t(".password_note") %></p>
    </div>

    <div>
      <%= f.label :password_confirmation, t(".password_confirmation_label"), class: "mb-2 block text-stone-600" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-xl border border-stone-500 px-4 py-3" %>
    </div>

    <div>
      <%= f.label :current_password, class: "mb-2 block text-stone-600" %>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full rounded-xl border border-stone-500 px-4 py-3" %>
    </div>

    <%= f.submit t(".submit"), data: { turbo_submits_with: t(".submitting") },
          class: "w-full cursor-pointer rounded-xl bg-teal-700 py-3 text-lg text-white hover:bg-teal-800 disabled:cursor-wait disabled:opacity-50" %>
  <% end %>
</div>
