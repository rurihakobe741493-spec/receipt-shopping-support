<% purchased_on_range = Purchase.purchased_on_range %>
<div class="px-4 py-10">
  <h1 class="text-xl"><%= t(".title") %></h1>

    <div class="mt-6 space-y-6">
    <% if purchased_on.nil? %>
      <p id="purchased_on_missing" class="rounded-xl border border-amber-700 bg-amber-950 px-4 py-3 text-amber-300">
        <%= t(".purchased_on_missing") %>
      </p>
    <% end %>

    <div class="flex items-center gap-3">
      <%= label_tag "purchased_on", Purchase.human_attribute_name(:purchased_on), class: "shrink-0 text-neutral-300" %>
      <%= date_field_tag "purchased_on", purchased_on,
            min: purchased_on_range.begin, max: purchased_on_range.end, required: true,
            class: "min-w-0 grow rounded-xl border px-4 py-3",
            aria: { describedby: ("purchased_on_missing" if purchased_on.nil?) } %>
    </div>

    <p class="text-neutral-300"><%= t(".instruction") %></p>

    <ul class="space-y-3">
      <% item_lines.each_with_index do |item_line, i| %>
        <li class="group grid gap-3 rounded-xl border p-4">
          <div class="flex items-center gap-3">
            <%= check_box_tag "rows[#{i}][selected]", "1", true,
                  class: "size-5 shrink-0 cursor-pointer", aria: { label: t(".row_checkbox_label") } %>
            <%= text_field_tag "rows[#{i}][receipt_name]", item_line,
                  class: "min-w-0 grow rounded-xl border px-4 py-3",
                  aria: { label: Purchase.human_attribute_name(:receipt_name) } %>
          </div>
          <div class="hidden items-center gap-3 pl-8 group-has-[input:checked]:flex">
            <%= label_tag "rows[#{i}][item_id]", Purchase.human_attribute_name(:item), class: "shrink-0 text-neutral-300" %>
            <%= select_tag "rows[#{i}][item_id]",
                  options_for_select([ [ t(".new_item"), "new" ] ]) + options_from_collection_for_select(items, :id, :name),
                  prompt: t(".select_prompt"), class: "min-w-0 grow rounded-xl border px-4 py-3" %>
          </div>
          <p class="pl-8 text-sm text-neutral-400 group-has-[input:checked]:hidden"><%= t(".unchecked_note") %></p>
        </li>
      <% end %>
    </ul>

    <%= link_to t(".cancel"), root_path,
          class: "block w-full rounded-xl border py-3 text-center text-lg hover:bg-neutral-800" %>
  </div>
</div>
