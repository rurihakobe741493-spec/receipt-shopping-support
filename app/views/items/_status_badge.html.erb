<%# 状態のバッジ（トップのカードとストック詳細）。もう切れているかも（赤）・そろそろ切れそう（黄）・購入記録なし（灰）。どれでもない品目は出さない %>
<% if estimate.overdue? %>
  <p class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800">
    <%= render "items/overdue_icon" %>
    <%= t("items.status.overdue") %>
  </p>
<% elsif estimate.running_low? %>
  <p class="inline-flex items-center gap-1 rounded-full bg-yellow-300 px-2 py-0.5 text-xs font-semibold text-yellow-900">
    <%= render "items/running_low_icon" %>
    <%= t("items.status.running_low") %>
  </p>
<% elsif estimate.last_purchased_on.nil? %>
  <p class="inline-flex rounded-full bg-stone-200 px-2 py-0.5 text-xs font-semibold text-stone-600">
    <%= t("items.status.no_purchases") %>
  </p>
<% end %>
