<div class="flex grow flex-col px-4 pt-10">
  <h1 class="text-xl"><%= t(".title") %></h1>

  <ul class="mt-4 divide-y border-t">
    <%= render partial: "items/row", collection: @estimates, as: :estimate %>
  </ul>

  <%= form_with url: receipt_scans_path, class: "group sticky bottom-0 mt-auto grid gap-3 bg-neutral-900 py-4" do |f| %>
    <div class="grid gap-3 group-aria-busy:hidden">
      <%= f.label :image, t(".scan.label"), class: "text-neutral-300" %>
      <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp", required: true,
            class: "w-full text-sm text-neutral-300 file:mr-3 file:rounded-xl file:border-0 file:bg-neutral-100 file:px-4 file:py-3 file:text-neutral-900" %>
    </div>
    <div class="hidden group-aria-busy:flex flex-col items-center gap-2 py-1 text-center">
      <span aria-hidden="true" class="size-6 animate-spin rounded-full border-2 border-neutral-600 border-t-neutral-100 motion-reduce:hidden"></span>
      <p><%= t(".scan.reading") %></p>
      <p class="text-sm text-neutral-300"><%= t(".scan.wait_note_html") %></p>
    </div>
    <p class="text-sm text-neutral-400"><%= t(".scan.external_notice") %></p>
    <%= f.submit t(".scan.submit"), data: { turbo_submits_with: t(".scan.submitting") },
          class: "w-full cursor-pointer rounded-xl bg-neutral-100 py-3 text-lg text-neutral-900 hover:bg-neutral-300 disabled:cursor-wait disabled:opacity-50" %>
  <% end %>
</div>
