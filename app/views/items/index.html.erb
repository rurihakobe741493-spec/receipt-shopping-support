<div class="flex grow flex-col px-4 pt-10">
  <h1 class="text-xl"><%= t(".title") %></h1>

  <% if @estimates.empty? %>
    <p class="mt-4 text-neutral-300"><%= t(".empty") %></p>
  <% else %>
    <% if @overdue_estimates.any? %>
      <h2 class="mt-6 flex items-center gap-2 text-lg text-red-300">
        <%# アイコン：Heroicons（MIT、Tailwind Labs）の archive-box-x-mark %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-5 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m6 4.125 2.25 2.25m0 0 2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"/>
        </svg>
        <%= t(".overdue_title") %>
      </h2>
      <ul class="mt-4 divide-y divide-red-900 rounded-xl border border-red-800 bg-red-950 px-4">
        <%= render partial: "items/row", collection: @overdue_estimates, as: :estimate %>
      </ul>
    <% end %>

    <% if @running_low_estimates.any? %>
      <h2 class="mt-6 flex items-center gap-2 text-lg text-amber-300">
        <%# アイコン：Heroicons（MIT、Tailwind Labs）の clock %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-5 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
        <%= t(".running_low_title") %>
      </h2>
      <ul class="mt-4 divide-y divide-amber-900 rounded-xl border border-amber-700 bg-amber-950 px-4">
        <%= render partial: "items/row", collection: @running_low_estimates, as: :estimate %>
      </ul>
    <% end %>

    <% if @other_estimates.any? %>
      <%# 上に枠があるときだけ見出しを出す（枠がないときは、h1 のすぐ下に一覧を置く） %>
      <% if @overdue_estimates.any? || @running_low_estimates.any? %>
        <h2 class="mt-6 text-lg"><%= t(".others_title") %></h2>
      <% end %>
      <ul class="mt-4 divide-y border-t">
        <%= render partial: "items/row", collection: @other_estimates, as: :estimate %>
      </ul>
    <% end %>
  <% end %>

  <%= form_with url: receipt_scans_path, class: "group sticky bottom-0 mt-auto grid gap-3 border-t bg-neutral-900 py-4" do |f| %>
    <div class="grid gap-3 group-aria-busy:hidden">
      <%= f.label :image, t(".scan.label"), class: "text-neutral-300" %>
      <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp", required: true,
            class: "w-full text-sm text-neutral-300 file:mr-3 file:rounded-xl file:border-0 file:bg-neutral-100 file:px-4 file:py-3 file:text-neutral-900" %>
    </div>
    <div class="hidden group-aria-busy:flex flex-col items-center gap-2 py-1 text-center">
      <span aria-hidden="true" class="size-6 animate-spin rounded-full border-2 border-neutral-600 border-t-neutral-100 motion-reduce:hidden"></span>
      <p><%= t(".scan.reading") %></p>
      <p class="text-sm text-neutral-300"><%= t(".scan.wait_note_html") %></p>
    </div>
    <p class="text-sm text-neutral-400"><%= t(".scan.external_notice") %></p>
    <%= f.submit t(".scan.submit"), data: { turbo_submits_with: t(".scan.submitting") },
          class: "w-full cursor-pointer rounded-xl bg-neutral-100 py-3 text-lg text-neutral-900 hover:bg-neutral-300 disabled:cursor-wait disabled:opacity-50" %>
  <% end %>
</div>
