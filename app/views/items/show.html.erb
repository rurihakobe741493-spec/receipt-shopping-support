<div class="px-4 py-10">
  <%= link_to root_path, class: "inline-flex items-center gap-1 text-sm text-teal-700 hover:text-teal-800" do %>
    <%# アイコン：Heroicons（MIT、Tailwind Labs）の chevron-left %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-4 shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/>
    </svg>
    <%= t(".back") %>
  <% end %>

  <%# 品目名と「編集」を横に並べる。長い品目名は左で折り返し、「編集」は右上に残す %>
  <div class="mt-3 flex items-start justify-between gap-3">
    <h1 class="min-w-0 text-xl wrap-break-word"><%= @item.name %></h1>
    <%= link_to t(".edit"), edit_item_path(@item), class: "shrink-0 rounded-lg border px-3 py-1 text-sm hover:bg-black/5" %>
  </div>

  <%# 要約の箱。トップの枠と同じ判定で、もう切れているかも（赤）・そろそろ切れそう（黄色）の色にする %>
  <div class="<%= class_names("mt-4 rounded-xl border px-4 py-3",
                    "border-red-200 bg-red-50": @estimate.overdue?,
                    "border-amber-200 bg-amber-50": @estimate.running_low?) %>">
    <% if @estimate.overdue? %>
      <p class="mb-2 flex items-center gap-2 text-red-700">
        <%= render "items/overdue_icon" %>
        <%= t("items.status.overdue") %>
      </p>
    <% elsif @estimate.running_low? %>
      <p class="mb-2 flex items-center gap-2 text-amber-700">
        <%= render "items/running_low_icon" %>
        <%= t("items.status.running_low") %>
      </p>
    <% end %>

    <%# 購入記録が0件の品目（最後の1件を消したときなど）は、次回購入目安と最終購入日の代わりに「購入記録なし」を出す %>
    <% if @estimate.last_purchased_on.nil? %>
      <p class="mb-2 text-stone-600"><%= t("items.status.no_purchases") %></p>
    <% end %>
    <dl class="grid gap-2">
      <% if @estimate.last_purchased_on %>
        <div class="flex justify-between gap-3">
          <dt class="text-stone-600"><%= t(".next_purchase") %></dt>
          <dd class="text-right">
            <%= days_left_text(@estimate.days_left) %>
            <span class="block text-sm text-stone-600"><%= l(@estimate.next_purchase_on) %></span>
          </dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="text-stone-600"><%= t(".last_purchased") %></dt>
          <dd class="text-right"><%= l(@estimate.last_purchased_on) %></dd>
        </div>
      <% end %>
      <div class="flex justify-between gap-3">
        <dt class="text-stone-600"><%= Item.human_attribute_name(:cycle_days) %></dt>
        <%# 数字と出どころの間に空白が入らないように、1行に書く %>
        <dd class="text-right"><%= t(".cycle_days_value", count: @estimate.cycle_days) %><span class="text-sm text-stone-600"><%= @estimate.cycle_from_purchases? ? t(".cycle_from_purchases") : t(".cycle_from_setting") %></span></dd>
      </div>
    </dl>
  </div>

  <h2 class="mt-6 text-lg"><%= t(".purchases_title") %></h2>
  <% if @estimate.last_purchased_on %>
    <ul class="mt-4 divide-y border-t">
      <%= render @purchases %>
    </ul>
  <% else %>
    <%# 0件のときも見出しは残し、登録し直すと次回購入目安が出ることを一言で伝える %>
    <p class="mt-4 text-stone-600"><%= t(".purchases_empty") %></p>
  <% end %>

  <%# 確認の窓（Turbo の data-turbo-confirm）で OK を押したときだけ送る。JavaScript が動かないときは、確認なしで消える %>
  <%# 消したあとは、詳細の履歴をトップに置き換える（data-turbo-action="replace"）。「戻る」で、消した品目の詳細（404）を開かないように %>
  <%# 購入記録が0件なら、件数の入らない文にする %>
  <% confirm = @item.purchases.empty? ? t(".destroy_confirm_no_purchases", name: @item.name) : t(".destroy_confirm", name: @item.name, count: @item.purchases.size) %>
  <%= button_to t(".destroy"), item_path(@item), method: :delete,
        form: { class: "mt-8", data: { turbo_action: "replace", turbo_confirm: confirm } },
        class: "w-full cursor-pointer rounded-lg border border-red-300 px-4 py-3 text-red-700 hover:bg-red-50 disabled:cursor-wait disabled:opacity-50" %>
</div>
