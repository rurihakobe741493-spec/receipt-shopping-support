<li>
  <%= link_to item_path(estimate.item), class: "-mx-2 flex gap-3 rounded-lg px-2 py-3 hover:bg-black/5 active:bg-black/10" do %>
    <div class="min-w-0 grow wrap-break-word">
      <p class="font-semibold"><%= estimate.item.name %></p>
      <p class="text-sm text-stone-600">
        <% if estimate.last_purchased_on %>
          <%= t(".last_purchased", date: l(estimate.last_purchased_on)) %>
        <% else %>
          <%= t("items.status.no_purchases") %>
        <% end %>
      </p>
    </div>
    <% if estimate.last_purchased_on %>
      <div class="shrink-0 text-right">
        <p><%= days_left_text(estimate.days_left) %></p>
        <p class="text-sm text-stone-600"><%= t(".next_purchase", date: l(estimate.next_purchase_on)) %></p>
      </div>
    <% end %>
    <%# アイコン：Heroicons（MIT、Tailwind Labs）の chevron-right。押すとストック詳細が開くことを示す %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-5 shrink-0 self-center text-stone-500">
      <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
    </svg>
  <% end %>
</li>
