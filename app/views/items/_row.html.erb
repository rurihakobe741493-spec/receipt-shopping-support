<li>
  <%# 品目ごとのカード。カード全体をストック詳細へのリンクにする %>
  <%# 乗せたとき・押したときの色は、ほかの行と同じ black/5・black/10 %>
  <%= link_to item_path(estimate.item), class: "block rounded-xl border bg-white px-4 py-3 hover:bg-black/5 active:bg-black/10" do %>
    <div class="flex items-start justify-between gap-3">
      <div class="flex min-w-0 flex-col items-start gap-1 wrap-break-word">
        <p class="font-semibold"><%= estimate.item.name %></p>
        <%= render "items/status_badge", estimate: %>
      </div>
      <%# そろそろ切れそうの数字は yellow-500。白の上で 1.9：1 で、文字の目安 4.5：1 に届かないが、見本と実際の画面で見比べて、 %>
      <%# 明るい黄のほうが赤との違いがひと目で分かり、見栄えもよかったため。読み上げとバッジの文字で状態は伝わる %>
      <% if estimate.last_purchased_on %>
        <p class="<%= class_names("shrink-0 text-right", "text-red-700": estimate.overdue?, "text-yellow-500": estimate.running_low?) %>">
          <%= days_left_tag(estimate.days_left, form: :short) %>
        </p>
      <% end %>
    </div>
    <% if estimate.last_purchased_on %>
      <div class="mt-3">
        <%= render "items/progress_bar", estimate: %>
      </div>
      <p class="mt-2 text-sm text-stone-600"><%= t(".next_purchase", date: l(estimate.next_purchase_on)) %></p>
    <% end %>
  <% end %>
</li>
